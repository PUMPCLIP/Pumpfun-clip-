# Example defaults target production callbacks; use localhost only in a local .env.
DATABASE_URL=postgres://pumpclip:pumpclip@localhost:5432/pumpclip
APP_URL=https://pumpclip.app
# Optional Privy auth: enable email, Google, Twitter, wallet login and Solana embedded wallets.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=
# Supabase Auth: allow https://pumpclip.app/auth in Auth URL Configuration; enable Google in Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# For compose.managed.yml: purchase/control a domain and point its DNS A/AAAA to the host.
STAGING_DOMAIN=
# Managed PostgreSQL staging requires DATABASE_URL with TLS (sslmode=require or verify-full).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Public Solana Pay receive address, embedded in the client bundle; blank disables tips.
NEXT_PUBLIC_SOLANA_WALLET_ADDRESS=
PUMPCLIP_MINT=
PUMPCLIP_DECIMALS=6
STREAMER_MIN_RAW=1
CLIPPER_MIN_RAW=1
STREAMER_FEE_RAW=1000000
CLIPPER_FEE_MIN_RAW=0
CLIPPER_FEE_MAX_RAW=1000000000
TOKEN_TREASURY=
SOL_TREASURY=
# The configured treasury also receives the verified 2 SOL monthly clip-plan deposit.
MIN_FUNDING_LAMPORTS=10000000
ALLOW_DEV_AUTH=false
# AI transcription (Whisper), up to 60 minutes per licensed source.
OPENAI_API_KEY=
# Private S3-compatible bucket shared by web and all workers. Direct URL ingestion
# is limited to HTTPS pages on YouTube, TikTok, Instagram, and X.
# Local/private media root. On a Render persistent disk use an absolute mount path,
# for example /var/data/pumpclip. A Render disk is instance-local; use MEDIA_BUCKET
# instead whenever more than one web/worker instance must share media.
PUMPCLIP_MEDIA_ROOT=data/private
VIDEO_WORKDIR=data/private/native-clips
MEDIA_BUCKET=
MEDIA_REGION=auto
MEDIA_ENDPOINT=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
MEDIA_SSE=
# 32 random bytes encoded in base64; encrypts social OAuth tokens at rest.
SOCIAL_TOKEN_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Set true only after video.upload approval, video.publish audit and a live account test.
TIKTOK_DIRECT_POST_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
X_CLIENT_ID=
X_CLIENT_SECRET=
# Deployment: set APP_URL to your HTTPS origin and DATABASE_URL to postgres service.
READINESS_MODE=core
# Set READINESS_MODE=full only when AI and every enabled social integration are provisioned.
