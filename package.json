{
  "name": "pumpclip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/cloudflare-build.mjs",
    "build:render": "next build",
    "cf-build": "node scripts/cloudflare-build.mjs",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:seed:trial-users": "node scripts/seed-trial-users.mjs",
    "sol:simulate-clip-plan": "node scripts/simulate-clip-plan-devnet.mjs",
    "worker": "node scripts/worker.mjs",
    "worker:ai": "node scripts/ai-worker.mjs",
    "worker:native": "node scripts/native-worker.mjs",
    "worker:channel": "node scripts/channel-worker.mjs",
    "token": "node scripts/token.mjs",
    "token:policy": "node scripts/policy.mjs",
    "payout": "node scripts/payout.mjs",
    "reports": "node scripts/reports.mjs",
    "readiness": "node scripts/readiness.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@privy-io/node": "^0.35.0",
    "@privy-io/react-auth": "^3.48.0",
    "@solana-program/memo": "^0.10.0",
    "@solana-program/system": "^0.10.0",
    "@solana-program/token": "^0.9.0",
    "@solana/kit": "^5.5.1",
    "@solana/web3.js": "^1.98.4",
    "@stripe/stripe-js": "^1.54.2",
    "@supabase/supabase-js": "^2.117.2",
    "bs58": "^6.0.0",
    "busboy": "^1.6.0",
    "jose": "^6.0.11",
    "next": "^15.5.0",
    "pg": "^8.16.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.5",
    "tweetnacl": "^1.0.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@opennextjs/cloudflare": "^1.20.8",
    "@solana/spl-token": "^0.4.15",
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "@wagmi/connectors": {
      "@walletconnect/ethereum-provider": "2.26.0"
    },
    "postcss": "8.5.29",
    "sharp": "0.35.5",
    "stream-json": "3.7.0",
    "ws": "8.22.0"
  }
}
